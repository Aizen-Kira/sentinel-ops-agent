# Copy this file to .env for local development.
# Never commit .env or real credentials.

# Runtime
NODE_ENV=development
PORT=3000

# Database - required outside tests.
DATABASE_URL=mysql://CHANGE_ME_USER:CHANGE_ME_PASSWORD@localhost:3306/sentinel_ops

# Auth - required outside tests.
# JWT_SECRET must be at least 32 random characters and must not use this sample.
JWT_SECRET=CHANGE_ME_AT_LEAST_32_RANDOM_CHARACTERS
APP_ID=sentinel-ops-local
VITE_APP_ID=sentinel-ops-local
OAUTH_SERVER_URL=https://oauth.example.com
OAUTH_PORTAL_URL=https://oauth.example.com
VITE_OAUTH_PORTAL_URL=https://oauth.example.com

# Optional: matching user openId is promoted to admin on sign-in.
OWNER_OPEN_ID=

# AI provider: auto, forge, or ollama.
AI_PROVIDER=auto
LLM_MODEL=gemini-2.5-flash

# Forge/cloud AI - required only when AI_PROVIDER=forge.
BUILT_IN_FORGE_API_URL=
BUILT_IN_FORGE_API_KEY=

# Local Ollama - OLLAMA_MODEL is required only when AI_PROVIDER=ollama.
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=

# Development event simulation.
VITE_DEMO_MODE=true
ENABLE_DEMO_EVENT_STREAM=false

# Splunk integration is optional. Omit these values for mock/demo mode.
SPLUNK_HEC_URL=
SPLUNK_HEC_TOKEN=
SPLUNK_HOST=localhost
SPLUNK_PORT=8089
SPLUNK_INDEX=main

# Anthropic AI is optional. Omit for local/mock LLM fallbacks.
# Used by risk scoring, investigation enrichment, and CISO briefing generation.
ANTHROPIC_API_KEY=
